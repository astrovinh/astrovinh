# Supabase project credentials
# Copy this file to .env.local and fill in your values
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Auth — Apple OAuth
# client_id: your Apple Services ID (e.g. com.yourcompany.pulse.auth)
# secret: generated JWT using your Apple private key (.p8 file)
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Supabase Auth — Google OAuth
# client_id: from Google Cloud Console → Credentials → OAuth 2.0 Client ID
# secret: corresponding client secret
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# PostHog Analytics
# API key from PostHog → Project Settings → Project API Key
EXPO_PUBLIC_POSTHOG_API_KEY=phc_YOUR_KEY_HERE
# Use https://us.i.posthog.com (US) or https://eu.i.posthog.com (EU)
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
